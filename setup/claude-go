#!/bin/bash
# claude-go: Updates rules + skills from GitHub, then launches Claude Code
# Usage: claude-go [project-name]
# Example: claude-go seekon.ai
#
# HYBRID LOADING (June 2026):
#   • CLAUDE.md = personal rules + design philosophy ONLY (always-on, lightweight)
#   • Skills live as folders in ~/.claude/skills and load ON-DEMAND, only when
#     a task actually needs them — so unrelated sessions stay fast and uncluttered.
#
# Skills source: github.com/watchdogpedro/claude-skills
# Personal rules: ~/.claude/CLAUDE-personal-rules.md (never overwritten)

PERSONAL_RULES="$HOME/.claude/CLAUDE-personal-rules.md"
CLAUDE_MD="$HOME/.claude/CLAUDE.md"
SKILLS_DIR="$HOME/.claude/skills"
REPO="watchdogpedro/claude-skills"
REPO_URL="https://github.com/$REPO.git"

# ─── Project Registry ────────────────────────────────────────────────────────
# Use any alias: claude-go seekon / claude-go seekon.ai / claude-go surnetics
# Uses case statement for bash 3.2 compatibility (macOS default)
get_project_path() {
  case "$1" in
    seekon|seekon.ai)                          echo "/Users/pauldenman/seekon.ai" ;;
    surnetics|surnetics.com)                   echo "/Users/pauldenman/surnetics" ;;
    anglelock)                                 echo "/Users/pauldenman/anglelock-new" ;;
    anglelockllc|anglelockllc.com)             echo "/Users/pauldenman/anglelockllc.com" ;;
    asc|asc-international|solderpaste)         echo "/Users/pauldenman/asc-international" ;;
    linearmotion)                              echo "/Users/pauldenman/linearmotion" ;;
    linearshaftmotor|linearshaftmotor.ai)      echo "/Users/pauldenman/linearshaftmotor.ai" ;;
    controlleddynamics)                        echo "/Users/pauldenman/controlleddynamics" ;;
    controlleddynamicsinc|controlleddynamicsinc.com) echo "/Users/pauldenman/controlleddynamicsinc.com" ;;
    pauldenman|pauldenman.com)                 echo "/Users/pauldenman/pauldenman.com" ;;
    christina|christinanoellee|christinanoellee.com) echo "/Users/pauldenman/christinanoellee.com" ;;
    *)                                         echo "" ;;
  esac
}
# ─────────────────────────────────────────────────────────────────────────────

# Skills that load on-demand from ~/.claude/skills (synced from the repo below).
# algorithmic-art and canvas-design are intentionally NOT here — the Anthropic
# skills plugin already provides both on-demand (canvas-design with its fonts).
# This list is documentation; actual sync is a single git pull of the repo.
ON_DEMAND_SKILLS=(
  "distinctive-design" "frontend-design" "motion-design"
  "web-design-expert" "frontend-development"
  "vercel-react-best-practices" "web-design-guidelines"
  "test-driven-development" "webapp-testing"
  "n8n-code-javascript" "n8n-code-python" "n8n-expression-syntax"
  "n8n-mcp-tools-expert" "n8n-node-configuration"
  "n8n-validation-expert" "n8n-workflow-patterns"
  "humanizer"
)

# ─── Project lookup (first argument) ─────────────────────────────────────────
PROJECT_ARG="${1:-}"
PROJECT_DIR=""

if [ -n "$PROJECT_ARG" ]; then
  PROJECT_DIR="$(get_project_path "$PROJECT_ARG")"
  if [ -z "$PROJECT_DIR" ]; then
    # Fallback: treat as a direct path
    if [ -d "$PROJECT_ARG" ]; then
      PROJECT_DIR="$PROJECT_ARG"
    else
      echo "⚠️  Unknown project: '$PROJECT_ARG'"
      echo "   Known aliases: seekon, surnetics, anglelock, anglelockllc, asc, linearmotion, linearshaftmotor, controlleddynamics, controlleddynamicsinc, pauldenman, christina"
      echo "   Launching Claude in current directory..."
    fi
  fi
fi
# ─────────────────────────────────────────────────────────────────────────────

# Keep memory compiler up to date
if [ -d "$HOME/.claude/memory-compiler" ]; then
  echo "Updating memory compiler..."
  git -C "$HOME/.claude/memory-compiler" pull --quiet 2>/dev/null || true
fi

# Keep awesome-claude-code reference up to date
if [ -d "$HOME/.claude/awesome-claude-code" ]; then
  git -C "$HOME/.claude/awesome-claude-code" pull --quiet 2>/dev/null || true
fi

# ─── Update on-demand skills (folders in ~/.claude/skills) ───────────────────
echo "Updating on-demand skills from GitHub ($REPO)..."
if [ -d "$SKILLS_DIR/.git" ]; then
  if git -C "$SKILLS_DIR" pull --quiet 2>/dev/null; then
    echo "  ✅ Skills updated (${#ON_DEMAND_SKILLS[@]} available, load only when needed)."
  else
    echo "  ⚠️  Skills update skipped (offline?) — using existing local skills."
  fi
else
  echo "  Cloning skills into $SKILLS_DIR ..."
  git clone --quiet "$REPO_URL" "$SKILLS_DIR" 2>/dev/null \
    && echo "  ✅ Skills cloned." \
    || echo "  ⚠️  Clone failed — continuing without skill sync."
fi
# ─────────────────────────────────────────────────────────────────────────────

# ─── Build CLAUDE.md = personal rules ONLY (always-on, lightweight) ───────────
if [ ! -f "$PERSONAL_RULES" ]; then
  echo "ERROR: Personal rules file not found at $PERSONAL_RULES"
  echo "Launching Claude without sync..."
  claude --dangerously-skip-permissions
  kill -TERM $PPID 2>/dev/null || exit 0
fi

cp "$PERSONAL_RULES" "$CLAUDE_MD"
echo "  ✅ CLAUDE.md set to personal rules + design philosophy (skills load on-demand)."
# ─────────────────────────────────────────────────────────────────────────────

# ─── cd + git pull if project specified ──────────────────────────────────────
if [ -n "$PROJECT_DIR" ]; then
  echo ""
  echo "📁 Project: $PROJECT_ARG"
  echo "   Path: $PROJECT_DIR"
  cd "$PROJECT_DIR" || { echo "ERROR: Could not cd to $PROJECT_DIR"; claude --dangerously-skip-permissions; kill -TERM $PPID 2>/dev/null; exit 0; }
  echo "   Pulling latest from GitHub..."
  git pull 2>&1 | sed 's/^/   /'
  echo ""
fi
# ─────────────────────────────────────────────────────────────────────────────

echo "Launching Claude Code (fresh session — no resume)..."
echo ""

# Run Claude fresh (no -c flag = no resume of last session)
claude --dangerously-skip-permissions

# After /exit — close this terminal window automatically
echo ""
echo "Session ended. Closing terminal..."
sleep 1
kill -TERM $PPID 2>/dev/null || exit 0
